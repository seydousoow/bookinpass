# Copier en .env (ignoré par git) puis renseigner.
# Jeton de test Duffel (https://app.duffel.com → Developers → Access tokens). Vide = mode démo.
DUFFEL_BASE_URL=
DUFFEL_ACCESS_TOKEN=
# Duffel Stays (hébergements) : produit à faire activer par Duffel. false = hébergements de démo (Dakar).
DUFFEL_STAYS_ENABLED=true
# Secret du webhook Duffel, rendu une seule fois à sa création (POST /air/webhooks, voir README).
DUFFEL_WEBHOOK_SECRET=

EXPEDIA_BASE_URL=
EXPEDIA_API_KEY=
EXPEDIA_SECRET=

# Journaux : niveau général, puis appels sortants (debug = URL et statut, trace = en-têtes et corps).
LOG_LEVEL=info
DUFFEL_LOG_LEVEL=info
STAYS_LOG_LEVEL=info
EXPEDIA_LOG_LEVEL=info
# Swagger UI et OpenAPI : false pour ne pas exposer la documentation de l'API.
API_DOCS_ENABLED=true

# Image du backend : native (GraalVM, défaut — Docker doit avoir 10 Go de mémoire) ou jvm (build rapide).
BACKEND_TARGET=native
BACKEND_HOST_PORT=8080

# Ports publiés sur la machine hôte, si les valeurs par défaut sont déjà prises.
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=

REDIS_HOST_PORT=6380
REDIS_PORT=6380

# Stripe (sk_test_… / pk_test_… en développement). Vides = paiement indisponible.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Secret de signature des webhooks (whsec_…) : Dashboard → Workbench → Webhooks, ou `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Origine du site, base du retour après un moyen de paiement à redirection.
FRONTEND_URL=http://localhost:4200

# Origines du front autorisées à appeler l'API (CORS), séparées par des virgules. Vide = celle de FRONTEND_URL.
# Utile seulement si le front et l'API sont sur des domaines différents.
CORS_ALLOWED_ORIGINS=

# E-mails aux voyageurs (réservation, modification, annulation), envoyés par AWS SES. false = rendus et journalisés
# seulement. L'expéditeur doit être vérifié dans SES (en bac à sable, les destinataires aussi).
MAIL_ENABLED=false
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_SENDER=reservations@bookinpass.com
AWS_SES_ALIAS=Book In Pass

# PayDunya : billets de car et activités payés par Wave / Orange Money / Free Money. Clés vides = moyen masqué.
# Base : https://app.paydunya.com/sandbox-api/v1 (test) ou https://app.paydunya.com/api/v1.
PAYDUNYA_BASE_URL=https://app.paydunya.com/sandbox-api/v1
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Moyens proposés sur la page PayDunya ; vide = tous ceux du compte.
PAYDUNYA_CHANNELS=wave-senegal,orange-money-senegal,free-money-senegal
# Adresse publique de l'IPN : https://<domaine de l'API>/api/transport/payments/paydunya
PAYDUNYA_CALLBACK_URL=

# Back-office du personnel : origine (CORS avec cookies), cookie de session (Lax si même site que l'API, sinon None ;
# Secure en HTTPS), premier administrateur créé au démarrage s'il n'en existe aucun (à retirer ensuite).
BACKOFFICE_URL=http://localhost:4300
STAFF_COOKIE_SAME_SITE=Lax
STAFF_COOKIE_SECURE=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Claude : modération et résumé des avis d'activités. Clé vide = avis modérés à la main seulement.
# Clé de compte de service limitée à un espace de travail dédié, avec expiration et limite de dépense.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_THINKING=false
ANTHROPIC_FALLBACKS=false
# Intervalle de la modération des avis (durée ISO-8601, PT5H = 5 heures).
REVIEW_MODERATION_INTERVAL=PT5H

# Hors Docker (IDE) seulement : Docker Compose fixe lui-même la base, Redis et le port. Décommenter au besoin.
# DATABASE_URL=jdbc:postgresql://<hôte>:5432/<base>
# (ou, à la place de DATABASE_URL) DATABASE_HOST=<hôte>  DATABASE_PORT=5432  DATABASE_NAME=<base>
# DATABASE_USER=<utilisateur>
# DATABASE_PASSWORD=<mot de passe>
# REDIS_HOST=localhost
# PORT=8080
# DUFFEL_FIXTURES_DIR=file:fixtures/duffel/
