# Copier en .env (ignoré par git) puis renseigner.
# Jeton de test Duffel (https://app.duffel.com → Developers → Access tokens). Vide = mode démo.
DUFFEL_BASE_URL=
DUFFEL_ACCESS_TOKEN=
# Duffel Stays (hébergements) : produit à faire activer par Duffel. false = hébergements de démo (Dakar).
DUFFEL_STAYS_ENABLED=true
# Secret du webhook Duffel, rendu une seule fois à sa création (POST /air/webhooks, voir README).
DUFFEL_WEBHOOK_SECRET=

EXPEDIA_BASE_URL=
EXPEDIA_API_KEY=
EXPEDIA_SECRET=

# Image du backend : native (GraalVM, défaut — Docker doit avoir 10 Go de mémoire) ou jvm (build rapide).
BACKEND_TARGET=jvm
BACKEND_HOST_PORT=8080

# Ports publiés sur la machine hôte, si les valeurs par défaut sont déjà prises.
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=

REDIS_HOST_PORT=6380
REDIS_PORT=6380
# Stripe (sk_test_… / pk_test_… en développement). Vides = paiement indisponible.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature des webhooks (whsec_…) : Dashboard → Workbench → Webhooks, ou `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Origine du site, base du retour après un moyen de paiement à redirection.
FRONTEND_URL=http://localhost:4200
# E-mails aux voyageurs (réservation, modification, annulation). Par défaut, Mailpit (compose.yaml) les reçoit
# tous : http://localhost:8025. Pour un vrai serveur SMTP, renseigner MAIL_HOST (vide = aucun envoi) et suivants.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Book In Pass <reservations@bookinpass.com>
