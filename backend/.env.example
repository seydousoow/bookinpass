# Copier en .env (ignoré par git) puis renseigner.
# Jeton de test Duffel (https://app.duffel.com → Developers → Access tokens). Vide = mode démo.
DUFFEL_BASE_URL=
DUFFEL_ACCESS_TOKEN=

EXPEDIA_BASE_URL=
EXPEDIA_API_KEY=
EXPEDIA_SECRET=

# Image du backend : native (GraalVM, défaut — Docker doit avoir 10 Go de mémoire) ou jvm (build rapide).
BACKEND_TARGET=jvm
BACKEND_HOST_PORT=8080

# Ports publiés sur la machine hôte, si les valeurs par défaut sont déjà prises.
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=

REDIS_HOST_PORT=6380
REDIS_PORT=6380
